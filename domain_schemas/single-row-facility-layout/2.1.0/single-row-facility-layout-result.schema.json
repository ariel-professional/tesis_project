        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "objective_id",
        "objective_version",
        "status",
        "unit",
        "horizon",
        "directed",
