{
  "$defs": {
    "AdjacencyFinding": {
      "additionalProperties": false,
      "properties": {
        "cause": {
          "enum": [
            "safety",
            "cross_contamination",
            "noise",
            "temperature",
            "privacy",
            "interference",
            "process"
          ],
          "title": "Cause",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "first_station_id": {
          "title": "First Station Id",
          "type": "string"
        },
        "policy": {
          "const": "warn",
          "title": "Policy",
          "type": "string"
        },
        "provenance": {
          "title": "Provenance",
          "type": "string"
        },
        "second_station_id": {
          "title": "Second Station Id",
          "type": "string"
        }
      },
      "required": [
        "first_station_id",
        "second_station_id",
        "cause",
        "explanation",
        "provenance",
        "policy"
      ],
      "title": "AdjacencyFinding",
      "type": "object"
    },
    "AdjacencyValueContribution": {
      "additionalProperties": false,
      "properties": {
        "first_station_id": {
          "title": "First Station Id",
          "type": "string"
        },
        "forward_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Forward Value"
        },
        "reverse_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reverse Value"
        },
        "second_station_id": {
          "title": "Second Station Id",
          "type": "string"
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Total"
        }
      },
      "required": [
        "first_station_id",
        "second_station_id",
        "forward_value",
        "total"
      ],
      "title": "AdjacencyValueContribution",
      "type": "object"
    },
    "AdjacencyValueResult": {
      "additionalProperties": false,
      "properties": {
        "contributions": {
          "items": {
            "$ref": "#/$defs/AdjacencyValueContribution"
          },
          "title": "Contributions",
          "type": "array"
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "directed": {
          "title": "Directed",
          "type": "boolean"
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ],
          "title": "Direction",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "matrix_id": {
          "title": "Matrix Id",
          "type": "string"
        },
        "objective_id": {
          "title": "Objective Id",
          "type": "string"
        },
        "objective_version": {
          "const": "1",
          "title": "Objective Version",
          "type": "string"
        },
        "reference_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Period"
        },
        "status": {
          "enum": [
            "conclusive",
            "inconclusive",
            "not_applicable",
            "not_calculated",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "objective_id",
        "objective_version",
        "matrix_id",
        "status",
        "unit",
        "directed",
        "direction"
      ],
      "title": "AdjacencyValueResult",
      "type": "object"
    },
    "CapturedFlowResult": {
