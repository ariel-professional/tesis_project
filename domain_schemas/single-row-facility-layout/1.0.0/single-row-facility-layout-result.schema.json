        "forest_structure",
        "prescribed_edge_count",
        "utility",
        "total_utility",
        "core_run_id",
        "feasibility",
        "compatible_layout_count",
        "availability_ratio",
        "restrictiveness_ratio",
        "technical_metrics",
        "diagnostics",
        "limitations",
        "dominated",
        "pareto_optimal"
