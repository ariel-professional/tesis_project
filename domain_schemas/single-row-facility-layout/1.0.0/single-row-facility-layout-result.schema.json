        "mandatory_component_ids": {
          "items": {
            "type": "string"
          },
          "title": "Mandatory Component Ids",
          "type": "array"
        },
        "pareto_case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Pareto Case Ids",
          "type": "array"
