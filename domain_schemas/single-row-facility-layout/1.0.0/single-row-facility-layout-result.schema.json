      "type": "string"
    },
    "stations": {
      "items": {
        "$ref": "#/$defs/Station"
      },
      "title": "Stations",
      "type": "array"
    },
    "study_description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Study Description"
    },
    "study_id": {
      "title": "Study Id",
      "type": "string"
    },
    "study_title": {
      "title": "Study Title",
      "type": "string"
    }
