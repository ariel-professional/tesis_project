      "title": "Designs",
      "type": "array"
    },
    "domain": {
      "$ref": "#/$defs/SingleRowDomainRef"
    },
    "execution": {
      "$ref": "#/$defs/DomainExecutionRef"
    },
    "generation": {
      "$ref": "#/$defs/GenerationMetrics"
    },
    "limitations": {
      "items": {
        "$ref": "#/$defs/DomainLimitation"
      },
