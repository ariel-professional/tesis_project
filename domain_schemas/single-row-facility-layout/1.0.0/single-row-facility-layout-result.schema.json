        "restrictiveness_ratio": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactFraction"
            },
            {
              "type": "null"
            }
          ]
        },
        "technical_metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/TechnicalMetrics"
            },
            {
              "type": "null"
            }
          ]
