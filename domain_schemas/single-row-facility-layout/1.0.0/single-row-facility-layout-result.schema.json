        "design_id",
        "design_title",
        "mandatory_component_ids",
        "candidate_component_ids",
        "theoretical_combinations",
        "valid_case_count",
        "invalid_combination_count",
        "base_case_id",
        "base_layout_count",
        "cases",
        "invalid_conflicts",
        "invalid_combinations",
        "pareto_case_ids"
